#!/bin/bash
# Runs small-model agents that tune motion values against a reference recording. See parity/README.md.
# Usage: parity/loop --target <reference.mov> [--moves 1,3] [--agents 3] [--rounds 4] [--model claude-haiku-5-5]
cd "$(dirname "$0")"
exec systemd-run --user --scope -q -p MemoryMax=3G -p MemorySwapMax=0 -- uv run -q python -W ignore -m parity loop "$@"
