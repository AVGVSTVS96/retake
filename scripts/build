#!/bin/bash
# Runs on the Mac. Generates the project and builds for the simulator, warnings as errors.
set -euo pipefail
cd "$(dirname "$0")/.."
xcodegen generate -q
xcodebuild -project Retake.xcodeproj -scheme Retake -sdk iphonesimulator -configuration Debug \
  -derivedDataPath build -quiet SWIFT_TREAT_WARNINGS_AS_ERRORS=YES build 2>&1 \
  | { grep -E "error|warning: " | grep -v "appintentsmetadataprocessor" || true; }
