#!/bin/sh
# Syncs the tree to the Mac, runs a command there, and copies screenshots back.
set -e
cd "$(dirname "$0")/.."
scripts/sync
ssh mac "cd ${RETAKE_MAC:-Developer/voice-memos} && $*"
mkdir -p shots/raw
rsync -a "mac:${RETAKE_MAC:-Developer/voice-memos}/shots/raw/" shots/raw/ 2>/dev/null || true
